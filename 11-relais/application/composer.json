{
    "name": "neotis/relais",
    "description": "Relais : suivi des demandes de SAV (application de démonstration, données fictives)",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true,
            "infection/extension-installer": false
        },
        "sort-packages": true,
        "platform": {
            "php": "8.4.1"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require-dev": {
        "infection/infection": "^0.35.12",
        "phpunit/phpunit": "^12"
    }
}
